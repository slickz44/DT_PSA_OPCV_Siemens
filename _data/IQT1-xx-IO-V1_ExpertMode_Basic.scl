FUNCTION_BLOCK "IQT1-xx-IO-V1_ExpertMode_Basic"
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : KReinhardt
FAMILY : 'IQT1-xx-IO-V1'
VERSION : 2.1
   VAR_INPUT 
      I_HWIO_Hardware_ID : HW_IO;
      I_T_Timeout : Time := T#10s;
      I_b_StartRead : Bool;
      I_b_StartWrite : Bool;
      I_b_StartSpecialCommand : Bool;
      I_b_UserMemory_UID : Bool;
      I_b_SingleEnhanced : Bool;
      I_b_Quit : Bool;
      I_w_ByteAddress : Word;
      I_i_ByteNumber : Int;
      I_B_TagType : Byte := 16#14;
   END_VAR

   VAR_OUTPUT 
      O_b_Done : Bool;
      O_b_NoDataCarrier : Bool;
      O_b_Busy : Bool;
      O_b_Finish : Bool;
      O_b_Error : Bool;
      O_B_Status : Byte;
      O_w_AccessCounter : Int;
      O_B_PQI : Byte;
   END_VAR

   VAR_IN_OUT 
      IO_b_SetRestart : Bool;
      IO_b_InitFinish : Bool;
      UserData : "IQT1-xx-IO-V1_ExpertMode_Basic_UDT";
   END_VAR

   VAR 
      MASK_UPDATEBIT_SLAVE : Byte := 32;
      MASK_UPDATEBIT_MASTER : Byte := 64;
      MASK_DELETEBIT : Byte := 128;
      RETVAL_SFC14 : Int;
      RETVAL_SFC15 : Int;
      HEAD : Struct
         TimeoutActive : Bool;
         NewData : Bool;
         NotExist : Bool;
         ExistTC : Bool;
         Error : Bool;
         TimeoutOccurred : Bool;
         ReceiveOK : Bool;
         SendOK : Bool;
         TagPresent : Bool;
         Done : Bool;
         Busy : Bool;
         EnhCmdActive : Bool;
         SglCmdActive : Bool;
         WriteCmdActive : Bool;
         ReadCmdActive : Bool;
         TransfToHead : Bool;
         QuitCmdActive : Bool;
         SpecialCmdActive : Bool;
         Execute : Bool;
      END_STRUCT;
      RTRIG_SetRestart {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      RTRIG_Quit {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      RTRIG_Read {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      RTRIG_Write {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      RTRIG_SpecialCommand {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      STATE_INIT : USInt;
      STATE_CMD : USInt;
      NumberOfTags : DWord;
      AccessConter_Int : Int;
      Error_ScanTime : Int;
      WATCHDOG {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME := ((), T#5s, (), (), (), ());
      InData : Array[0..33] of Byte;
      OutData : Array[0..31] of Byte;
      statEdge1 : Bool;
      statFlag : Bool;
      Counter_FP : Int;
      Resp_Telegram_1 : Array[0..31] of Byte;
      Resp_Telegram_2 : Array[0..31] of Byte;
      Resp_Telegram_3 : Array[0..31] of Byte;
      Resp_Telegram_4 : Array[0..31] of Byte;
      Resp_Telegram_5 : Array[0..31] of Byte;
      Resp_Telegram_6 : Array[0..31] of Byte;
      Resp_Telegram_7 : Array[0..31] of Byte;
      Resp_Telegram_8 : Array[0..31] of Byte;
      Resp_Telegram_9 : Array[0..31] of Byte;
      Resp_Telegram_10 : Array[0..31] of Byte;
      FragmentCounter_1 : Byte;
      FragmentCounter_2 : Byte;
      FragmentCounter_3 : Byte;
      FragmentCounter_4 : Byte;
      FragmentCounter_5 : Byte;
      FragmentCounter_6 : Byte;
      FragmentCounter_7 : Byte;
      FragmentCounter_8 : Byte;
      FragmentCounter_9 : Byte;
      FragmentCounter_10 : Byte;
      StartReadDataTransmission : Bool;
      SingleCommandFinished : Bool;
      UpdateSlave_IN : Bool;
      statEdgeA : Bool;
      statEdgeB : Bool;
      statFlagC : Bool;
   END_VAR


BEGIN
	(*
	#############################################################################################
	
	General Header
	------------------------------------------------------------------------------------------
	Short description:  Function Block for IQT1-xx-IO-V1 Expert Mode with ICE11 and 33 Byte telegram length and ICE1/ICE3 with 32 Byte telegram length
	Version:            2.1
	Name:               Expert Mode IQT1-xx-IO-V1 for ICE11 with 33 Byte telegram length and ICE1/ICE3 with 32 Byte telegram length
	Date:               2024-03-14
	Company:            Pepperl+Fuchs SE
	Author:             Karsten Reinhardt
	EMail:              kreinhardt@de.pepperl-fuchs.com
	Phone:              +49 (0) 621 776 1736
	
	##############################################################################################
	PLEASE NOTE:
	User-Changes made in consultation with the author, Karsten Reinhardt
	 (2026-03-18 by Juergen Florig , FLORIG Steuerungstechnik)
	
	The "InData" array was increased from 32 bytes (0..31) to 34 bytes (0..33). 
	Reason: The used Murr IO-Link master (part number 54630) apparently transmits the PQI byte as a WORD.
	This resulted in a range length overrun during the transfer of the process input data
	(error code -32591 dec / 80B1 hex on SFC14).    
	##############################################################################################
	
	Changes V2.1    2024-03-14
	- change generating internal response counter with signal change of Update slave bit (Input[0].%X5)
	- each new telegram Update slave bit will change and the counter increases
	- can use in combination with IO-Link Masters with a telegram length of 32 and 33 Bytes
	
	Changes V2.0    2023-11-30
	- compleatly new version compared to the former function block for Expert Mode in combination with IQT1-xx-IO-V1 (old Version V1.1 2018-05-23)
	- old version does not support fragmentation and was limited in the number of readable bytes
	- new Version (V2.0) based on function block for IQT3-FP-IO-V1 (V1.0) --> see version information below
	- execute Change Tag command for TagType configuration as initialisation routine instead of the quit command; add input parameter TagType
	- adopt ReadData array inside UDT to a length of 192 Bytes (maximal length of read in data with one command)
	- remove unused arrays like UID_WrittenTag and UID_TagLeave which does not used by the IQT1-xx-IO-V1 system
	- single command ends with status 16#00 or status 16#05 message and not with status 16#0B message like IQT3-FP-IO-V1
	
	
	Changes V1.0    2023-11-08
	- based on the Version V2.0 of the ExpertMode function block for the IUT-F191-IO-V1 (see comments below)
	- change check of the length information for the status 16#0B telegram which contains RSSI value (length different compared to IUT-F191)
	- remove EPC input and EPC specific commands
	- rename EPC to UID
	- switch from 2-byte word commands (#SR; #ER; #SW; #EW) to 4-byte block commands (SR; ER; SW; EW)
	
	Pre-Version of the IUT-F191-IO-V1
	Changes V2.0    2023-10-05
	- version for telegram length of 33 Byte (32 Byte Process data + 1 Byte PQI)
	- usage in combination with ICE11 IO-Link Master
	- add PQI Byte as output (Q_B_PQI) in the function block
	- increase internal array (InData) to a size of 33 Byte
	- based on the Version V2.0 for the IO-Link Master ICE1 and ICE3
	- increase number of read in Bytes from User Memory to 192 Bytes
	- increase ReadData area to a length of 300 Byte
	- Fragmentation for read commands implemented
	- write command is limited to a length of up to 22 Byte
	- implement time measurement for status 16#00 (read io), status 16#0B (RSSI) and status 16#0F (end of single command)
	- store up to 10 response telegrams inside instance data block
	- can used for Long Form and Short Form data format
	
	Changes V1.0    2023-07-03
	- Initial version
	- based on version for Expert Mode from the IUT-F190-B40
	- no telegram fragmentation supported
	- include arrays (10pcs) to store up to 10 response telegrams inside instance data block
	- when the limit is reached the following telegram is stored in the first field (ring buffer)
	- execute 2-Byte Words commands (Single/Enhanced Read/Write) instead of 4-Byte Blocks commands
	- clear output data field if quit command is triggered during initialisation
	*)
	
	(*Read in process data; copy into #InData structure*)
	#RETVAL_SFC14                                       := DPRD_DAT(LADDR := #I_HWIO_Hardware_ID, RECORD => #InData);
	
	#O_B_PQI := #InData[32];
	
	(* Check every cycle if a new telegram is available *)
	IF (((#InData[0]) AND #MASK_UPDATEBIT_SLAVE) = ((#OutData[0] AND #MASK_UPDATEBIT_SLAVE))) THEN
	    #HEAD.ReceiveOK                                 := TRUE;    (* inform PLC, that a new telegram is available *)
	    
	ELSE
	    #HEAD.ReceiveOK                                 := FALSE;   (* inform PLC, that no new telegram is available *)
	END_IF;
	
	(*Copy Update slave bit into internal variable*)
	#UpdateSlave_IN := #InData[0].%X5;
	
	(*Trigger for positive edge on Update slave bit*)
	#statEdgeA := #UpdateSlave_IN AND NOT #statFlagC;
	
	(*Trigger for negative edge on Update slave bit*)
	#statEdgeB := NOT #UpdateSlave_IN AND #statFlagC;
	
	#statFlagC := #UpdateSlave_IN;
	
	//generate Testcounter
	IF (#statEdgeA = TRUE) OR (#statEdgeB = TRUE) THEN
	    #Counter_FP := #Counter_FP + 1;     // increment each new response telegram
	END_IF;
	
	//generate a pulse signal which is set for only one cycle     
	//    #statEdge1                                      := #HEAD.ReceiveOK AND NOT #statFlag;
	//    #statFlag                                       := #HEAD.ReceiveOK;
	//generate counter to count numbers of pulse signals which identically to the number of response telegrams    
	//    IF #statEdge1 = True THEN
	//        #Counter_FP                                 := #Counter_FP + 1;     // increment each new response telegram
	//    END_IF;
	    
	//first response telegram after send command
	    IF #Counter_FP = 1 THEN
	        MOVE_BLK(IN := #InData[0], OUT => #Resp_Telegram_1[0], COUNT := 32);               //Copy InData to internal data structure of telegram 1
	        #FragmentCounter_1 := #Resp_Telegram_1[2];                  //Fragment counter of first response telegram                    
	        IF ((#Resp_Telegram_1[6] = 16#00) OR (#Resp_Telegram_1[6] = 16#04)) AND (#Resp_Telegram_1[5] <> 16#02) THEN              //Status
	            MOVE_BLK(IN := #Resp_Telegram_1[7], COUNT := 26, OUT => #UserData.ReadData[0]);  //copy data from internal structure to ReadData
	            #StartReadDataTransmission := True;
	        END_IF;
	        
	        IF #FragmentCounter_1 >= 16#00 AND #Resp_Telegram_1[6] = 16#00 THEN
	            #O_b_NoDataCarrier := False;
	            #O_b_Error := FALSE;
	        END_IF;
	        
	        IF #FragmentCounter_1 = 16#00 THEN
	            IF #Resp_Telegram_1[1] = 16#07 AND #Resp_Telegram_1[4] = 16#04 AND #Resp_Telegram_1[6] = 16#05 THEN  // No Tag
	                #HEAD.Done := False;
	                #HEAD.NewData := True;
	                #HEAD.Execute := FALSE;
	                #HEAD.TimeoutActive := FALSE;
	                #O_b_NoDataCarrier := True;
	                #Counter_FP := 16#00;
	                #O_B_Status := #Resp_Telegram_1[6];
	                #O_b_Done := False;
	                #O_b_Error := FALSE;
	              //  IF #statEdge1 = True THEN
	                IF (#statEdgeA = TRUE) OR (#statEdgeB = TRUE) THEN
	                    #Error_ScanTime := RD_LOC_T(#UserData.Date_Status_05);
	                    #UserData.Time_Status_05 := T_DIFF(IN1 := #UserData.Date_Status_05, IN2 := #UserData.Date_Start_Command);
	                END_IF;
	            END_IF;
	            IF  #Resp_Telegram_1[6] = 16#00 THEN
	                #HEAD.Done := False;
	                #HEAD.NewData := True;
	                #HEAD.Execute := FALSE;
	                #HEAD.TimeoutActive := FALSE;
	                #O_b_NoDataCarrier := FALSE;
	                #O_B_Status := #Resp_Telegram_1[6];
	                #O_b_Done := TRUE;
	                #O_b_Error := FALSE;
	              //  IF #statEdge1 = True AND #Resp_Telegram_1[5] <> 16#04 AND #Resp_Telegram_1[6] = 16#00  AND NOT #HEAD.QuitCmdActive = True THEN
	                IF ((#statEdgeA = TRUE) OR (#statEdgeB = TRUE)) AND #Resp_Telegram_1[5] <> 16#04 AND #Resp_Telegram_1[6] = 16#00  AND NOT #HEAD.QuitCmdActive = True THEN
	                    #AccessConter_Int := #AccessConter_Int + 1;                                                             //increment internal counter
	                    #O_w_AccessCounter := #AccessConter_Int;
	                    #Error_ScanTime := RD_LOC_T(#UserData.Date_Status_00);                                               //read out local data
	                    #UserData.Time_Status_00 := T_DIFF(IN1 := #UserData.Date_Status_00, IN2 := #UserData.Date_Start_Command);   //calculate reading time
	                END_IF;
	            END_IF;
	            IF #HEAD.SglCmdActive = True AND (#Resp_Telegram_1[6] = 16#05 OR #Resp_Telegram_1[6] = 16#00) THEN
	                #O_b_Finish := True;
	                #O_b_Done := True;
	                #O_b_Busy := False;
	                #HEAD.SglCmdActive := False;
	                #HEAD.ReadCmdActive := False;
	            END_IF;
	            IF #HEAD.SglCmdActive = True AND #Resp_Telegram_1[6] = 16#04 THEN
	                #O_b_Finish := True;
	                #O_b_Done := True;
	                #O_b_Busy := False;
	                #HEAD.SglCmdActive := False;
	                #HEAD.ReadCmdActive := False;
	                #HEAD.TimeoutActive := FALSE;
	                #HEAD.Execute := FALSE;
	                #HEAD.Busy := FALSE;
	                #O_b_Error := True;
	                #O_B_Status := #Resp_Telegram_1[6];
	            END_IF;
	            IF #HEAD.EnhCmdActive = True AND #Resp_Telegram_1[6] = 16#04 THEN
	                #O_b_Done := True;
	                #HEAD.ReadCmdActive := False;
	                #HEAD.TimeoutActive := FALSE;
	                #O_b_Error := True;
	                #O_B_Status := #Resp_Telegram_1[6];
	                #Counter_FP := 16#00;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    IF #Counter_FP = 2 THEN
	        #HEAD.TimeoutActive := FALSE;
	        MOVE_BLK(IN := #InData[0],OUT => #Resp_Telegram_2[0], COUNT := 32);
	        #FragmentCounter_2 := #Resp_Telegram_2[2];
	        IF #FragmentCounter_2 >= 16#00 AND #StartReadDataTransmission = TRUE THEN
	            MOVE_BLK(IN := #Resp_Telegram_2[3], COUNT := 29, OUT => #UserData.ReadData[25]);
	        END_IF;
	        IF #FragmentCounter_2 = 16#00 THEN
	            #StartReadDataTransmission := False;
	        END_IF;
	        
	        IF #FragmentCounter_2 = 16#00 THEN
	            IF #Resp_Telegram_2[1] = 16#07 AND #Resp_Telegram_2[4] = 16#04 AND #Resp_Telegram_2[6] = 16#05 THEN
	                #HEAD.Done := False;
	                #HEAD.NewData := True;
	                #HEAD.Execute := FALSE;
	                #HEAD.TimeoutActive := FALSE;
	                #O_b_NoDataCarrier := True;
	                #Counter_FP := 16#00;
	                #O_B_Status := #Resp_Telegram_2[6];
	                #O_b_Done := False;
	              //  IF #statEdge1 = True THEN
	                IF (#statEdgeA = TRUE) OR (#statEdgeB = TRUE) THEN
	                    #Error_ScanTime := RD_LOC_T(#UserData.Date_Status_05);
	                    #UserData.Time_Status_05 := T_DIFF(IN1 := #UserData.Date_Status_05, IN2 := #UserData.Date_Start_Command);
	                    #UserData.Time_Tag_in_Zone := T_DIFF(IN1 := #UserData.Date_Status_05, IN2 := #UserData.Date_Status_00);
	                END_IF;
	            END_IF;
	            IF #HEAD.SglCmdActive = True THEN
	                #HEAD.Done := TRUE;
	                #HEAD.Busy := False;
	                #O_b_Done := True;
	                #O_b_Busy := False;
	                #HEAD.NewData := False;
	                #O_b_Finish := True;
	                #O_B_Status := #Resp_Telegram_1[6];
	                #HEAD.SglCmdActive := FALSE;
	                #HEAD.WriteCmdActive := FALSE;
	                #HEAD.ReadCmdActive := False;
	                #HEAD.Execute := FALSE;
	                #HEAD.TimeoutActive := FALSE;
	                #SingleCommandFinished := TRUE;
	              //  IF #statEdge1 = True THEN
	                IF (#statEdgeA = TRUE) OR (#statEdgeB = TRUE) THEN
	                    #AccessConter_Int := #AccessConter_Int + 1;                                                             //increment internal counter
	                    #O_w_AccessCounter := #AccessConter_Int;
	                    #Error_ScanTime := RD_LOC_T(#UserData.Date_Status_00);                                               //read out local data
	                    #UserData.Time_Status_00 := T_DIFF(IN1 := #UserData.Date_Status_00, IN2 := #UserData.Date_Start_Command);   //calculate reading time
	                END_IF;
	            END_IF;
	            IF #HEAD.EnhCmdActive = True THEN
	                #HEAD.Done := False;
	                #HEAD.NewData := True;
	                #HEAD.Execute := FALSE;
	                #HEAD.TimeoutActive := FALSE;
	                #O_b_Done := TRUE;
	                #O_B_Status := #Resp_Telegram_1[6];
	               // IF #statEdge1 = True AND #Resp_Telegram_2[6] <> 16#05 THEN
	                IF ((#statEdgeA = TRUE) OR (#statEdgeB = TRUE)) AND #Resp_Telegram_2[6] <> 16#05 THEN
	                    #AccessConter_Int := #AccessConter_Int + 1;                                                             //increment internal counter
	                    #O_w_AccessCounter := #AccessConter_Int;
	                    #Error_ScanTime := RD_LOC_T(#UserData.Date_Status_00);                                               //read out local data
	                    #UserData.Time_Status_00 := T_DIFF(IN1 := #UserData.Date_Status_00, IN2 := #UserData.Date_Start_Command);   //calculate reading time
	                END_IF;
	            END_IF;
	            IF #HEAD.EnhCmdActive = True AND #Resp_Telegram_2[6] = 16#05 THEN
	                #O_b_Done := FALSE;
	                #O_B_Status := #Resp_Telegram_2[6];
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    IF #Counter_FP = 3 THEN
	        MOVE_BLK(IN := #InData[0], OUT => #Resp_Telegram_3[0], COUNT := 32);
	        #FragmentCounter_3 := #Resp_Telegram_3[2];
	        IF #FragmentCounter_3 >= 16#00 AND #StartReadDataTransmission = TRUE THEN
	            MOVE_BLK(IN := #Resp_Telegram_3[3],COUNT := 29, OUT => #UserData.ReadData[54]);
	        END_IF;
	        IF #FragmentCounter_3 = 16#00 THEN
	            #StartReadDataTransmission := False;
	        END_IF;
	        
	        IF #FragmentCounter_3 = 16#00 THEN
	            IF #Resp_Telegram_3[1] = 16#07 AND #Resp_Telegram_3[4] = 16#04 AND #Resp_Telegram_3[6] = 16#05 THEN
	                #HEAD.Done := False;
	                #HEAD.NewData := True;
	                #HEAD.Execute := FALSE;
	                #HEAD.TimeoutActive := FALSE;
	                #O_b_NoDataCarrier := True;
	                #Counter_FP := 16#00;
	                #O_B_Status := #Resp_Telegram_3[6];
	                #O_b_Done := False;
	              //  IF #statEdge1 = True THEN
	                IF (#statEdgeA = TRUE) OR (#statEdgeB = TRUE) THEN
	                    #Error_ScanTime := RD_LOC_T(#UserData.Date_Status_05);
	                    #UserData.Time_Status_05 := T_DIFF(IN1 := #UserData.Date_Status_05, IN2 := #UserData.Date_Start_Command);
	                    #UserData.Time_Tag_in_Zone := T_DIFF(IN1 := #UserData.Date_Status_05, IN2 := #UserData.Date_Status_00);
	                END_IF;
	            END_IF;
	            IF #HEAD.SglCmdActive = True THEN
	                #HEAD.Done := TRUE;
	                #HEAD.Busy := False;
	                #O_b_Done := True;
	                #O_b_Busy := False;
	                #HEAD.NewData := False;
	                #O_b_Finish := True;
	                #O_B_Status := #Resp_Telegram_1[6];
	                #HEAD.SglCmdActive := FALSE;
	                #HEAD.WriteCmdActive := FALSE;
	                #HEAD.ReadCmdActive := False;
	                #HEAD.Execute := FALSE;
	                #HEAD.TimeoutActive := FALSE;
	                #SingleCommandFinished := TRUE;
	              //  IF #statEdge1 = True THEN
	                IF (#statEdgeA = TRUE) OR (#statEdgeB = TRUE) THEN
	                    #AccessConter_Int := #AccessConter_Int + 1;                                                             //increment internal counter
	                    #O_w_AccessCounter := #AccessConter_Int;
	                    #Error_ScanTime := RD_LOC_T(#UserData.Date_Status_00);                                               //read out local data
	                    #UserData.Time_Status_00 := T_DIFF(IN1 := #UserData.Date_Status_00, IN2 := #UserData.Date_Start_Command);   //calculate reading time
	                END_IF;
	            END_IF;
	            IF #HEAD.EnhCmdActive = True THEN
	                #HEAD.Done := False;
	                #HEAD.NewData := True;
	                #HEAD.Execute := FALSE;
	                #HEAD.TimeoutActive := FALSE;
	                #O_b_Done := TRUE;
	                #O_B_Status := #Resp_Telegram_1[6];
	               // IF #statEdge1 = True AND #Resp_Telegram_3[6] <> 16#05 THEN
	                IF ((#statEdgeA = TRUE) OR (#statEdgeB = TRUE)) AND #Resp_Telegram_3[6] <> 16#05 THEN
	                    #AccessConter_Int := #AccessConter_Int + 1;                                                             //increment internal counter
	                    #O_w_AccessCounter := #AccessConter_Int;
	                    #Error_ScanTime := RD_LOC_T(#UserData.Date_Status_00);                                               //read out local data
	                    #UserData.Time_Status_00 := T_DIFF(IN1 := #UserData.Date_Status_00, IN2 := #UserData.Date_Start_Command);   //calculate reading time
	                END_IF;
	            END_IF;
	            IF #HEAD.EnhCmdActive = True AND #Resp_Telegram_3[6] = 16#05 THEN
	                #O_b_Done := FALSE;
	                #O_B_Status := #Resp_Telegram_3[6];
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    IF #Counter_FP = 4 THEN
	        MOVE_BLK(IN := #InData[0], OUT => #Resp_Telegram_4[0],  COUNT := 32);
	        #FragmentCounter_4 := #Resp_Telegram_4[2];
	        IF #FragmentCounter_4 >= 16#00 AND #StartReadDataTransmission = TRUE THEN
	            MOVE_BLK(IN := #Resp_Telegram_4[3], COUNT := 29, OUT => #UserData.ReadData[83]);
	        END_IF;
	        IF #FragmentCounter_4 = 16#00 THEN
	            #StartReadDataTransmission := False;
	        END_IF;
	        
	        IF #FragmentCounter_4 = 16#00 THEN
	            IF #Resp_Telegram_4[1] = 16#07 AND #Resp_Telegram_4[4] = 16#04 AND #Resp_Telegram_4[6] = 16#05 THEN
	                #HEAD.Done := False;
	                #HEAD.NewData := True;
	                #HEAD.Execute := FALSE;
	                #HEAD.TimeoutActive := FALSE;
	                #O_b_NoDataCarrier := True;
	                #Counter_FP := 16#00;
	                #O_B_Status := #Resp_Telegram_4[6];
	                #O_b_Done := False;
	               // IF #statEdge1 = True THEN
	                IF (#statEdgeA = TRUE) OR (#statEdgeB = TRUE) THEN
	                    #Error_ScanTime := RD_LOC_T(#UserData.Date_Status_05);
	                    #UserData.Time_Status_05 := T_DIFF(IN1 := #UserData.Date_Status_05, IN2 := #UserData.Date_Start_Command);
	                    #UserData.Time_Tag_in_Zone := T_DIFF(IN1 := #UserData.Date_Status_05, IN2 := #UserData.Date_Status_00);
	                END_IF;
	            END_IF;
	            IF #HEAD.SglCmdActive = True THEN
	                #HEAD.Done := TRUE;
	                #HEAD.Busy := False;
	                #O_b_Done := True;
	                #O_b_Busy := False;
	                #HEAD.NewData := False;
	                #O_b_Finish := True;
	                #O_B_Status := #Resp_Telegram_1[6];
	                #HEAD.SglCmdActive := FALSE;
	                #HEAD.WriteCmdActive := FALSE;
	                #HEAD.ReadCmdActive := False;
	                #HEAD.Execute := FALSE;
	                #HEAD.TimeoutActive := FALSE;
	                #SingleCommandFinished := TRUE;
	             //   IF #statEdge1 = True THEN
	                IF (#statEdgeA = TRUE) OR (#statEdgeB = TRUE) THEN
	                    #AccessConter_Int := #AccessConter_Int + 1;                                                             //increment internal counter
	                    #O_w_AccessCounter := #AccessConter_Int;
	                    #Error_ScanTime := RD_LOC_T(#UserData.Date_Status_00);                                               //read out local data
	                    #UserData.Time_Status_00 := T_DIFF(IN1 := #UserData.Date_Status_00, IN2 := #UserData.Date_Start_Command);   //calculate reading time
	                END_IF;
	            END_IF;
	            IF #HEAD.EnhCmdActive = True THEN
	                #HEAD.Done := False;
	                #HEAD.NewData := True;
	                #HEAD.Execute := FALSE;
	                #HEAD.TimeoutActive := FALSE;
	                #O_b_Done := TRUE;
	                #O_B_Status := #Resp_Telegram_1[6];
	              //  IF #statEdge1 = True AND #Resp_Telegram_4[6] <> 16#05 THEN
	                IF ((#statEdgeA = TRUE) OR (#statEdgeB = TRUE)) AND #Resp_Telegram_4[6] <> 16#05 THEN
	                    #AccessConter_Int := #AccessConter_Int + 1;                                                             //increment internal counter

	#RTRIG_Read(CLK                                     :=  #I_b_StartRead);        (*Read Input*)
	#RTRIG_Write(CLK                                    :=  #I_b_StartWrite);       (*Write Input*)
	#RTRIG_SpecialCommand(CLK                           :=  #I_b_StartSpecialCommand);   (*SpecialCommand Input*)
	
	(* Handling of the SetRestart Routine
	- routine consist of the flip of the Delete Bit and the execution of the Change Tag command
	*) 
	IF #RTRIG_SetRestart.Q THEN                                                     (*Check positive edge on SetRestart input*)
	    #STATE_INIT                                     := 1;
	    #STATE_CMD                                      := 0;
	    #Counter_FP                                     := 0;
	END_IF;
	
	CASE #STATE_INIT OF
	        
	    0:  (* ********************** Idle state ******************* *)
	        ;
	    1:  (* ********************** Initialize variables  ******************* *)
	        
	        (*Reset internal variables and Outputs*) 
	        #IO_b_InitFinish                            := FALSE;
	        #HEAD.ExistTC                               := FALSE;
	        #HEAD.NotExist                              := FALSE;
	        #HEAD.Done                                  := FALSE;
	        #O_b_Done                                   := False;
	        #HEAD.Error                                 := FALSE;
	        #O_b_Error                                  := False;
	        #HEAD.Busy                                  := FALSE;
	//        #O_b_Busy                                   := False;
	        #HEAD.SglCmdActive                          := FALSE;
	        #HEAD.EnhCmdActive                          := FALSE;
	        #HEAD.QuitCmdActive                         := FALSE;
	        #HEAD.ReadCmdActive                         := FALSE;
	        #HEAD.SpecialCmdActive                      := FALSE;
	        #HEAD.NewData                               := FALSE;
	        #HEAD.TimeoutActive                         := FALSE;
	        #HEAD.TimeoutOccurred                       := FALSE;
	        #HEAD.TransfToHead                          := FALSE;
	        #HEAD.SendOK                                := FALSE;
	        #HEAD.Execute                               := FALSE;
	        #HEAD.ReceiveOK                             := FALSE;
	        #HEAD.WriteCmdActive                        := FALSE;
	        #O_b_NoDataCarrier                          := False;
	        #O_b_Finish                                 := False;
	        #O_w_AccessCounter                          := 0;
	        #AccessConter_Int                           := 0;
	        
	        //Reset Date for status 16#00 telegrams
	        #UserData.Date_Status_00.NANOSECOND         := 16#00;
	        #UserData.Date_Status_00.SECOND             := 0;
	        #UserData.Date_Status_00.MINUTE             := 0;
	        #UserData.Date_Status_00.HOUR               := 0;
	        #UserData.Date_Status_00.WEEKDAY            := 1;
	        #UserData.Date_Status_00.DAY                := 1;
	        #UserData.Date_Status_00.MONTH              := 1;
	        #UserData.Date_Status_00.YEAR               := 1970;
	        //Reset Date for status 16#05 telegrams
	        #UserData.Date_Status_05.NANOSECOND         := 16#00;
	        #UserData.Date_Status_05.SECOND             := 0;
	        #UserData.Date_Status_05.MINUTE             := 0;
	        #UserData.Date_Status_05.HOUR               := 0;
	        #UserData.Date_Status_05.WEEKDAY            := 1;
	        #UserData.Date_Status_05.DAY                := 1;
	        #UserData.Date_Status_05.MONTH              := 1;
	        #UserData.Date_Status_05.YEAR               := 1970;
	        //Reset Date for Start ReadWrite (Trigger) to Default value
	        #UserData.Date_Start_Command.NANOSECOND     := 16#00;
	        #UserData.Date_Start_Command.SECOND         := 0;
	        #UserData.Date_Start_Command.MINUTE         := 0;
	        #UserData.Date_Start_Command.HOUR           := 0;
	        #UserData.Date_Start_Command.WEEKDAY        := 1;
	        #UserData.Date_Start_Command.DAY            := 1;
	        #UserData.Date_Start_Command.MONTH          := 1;
	        #UserData.Date_Start_Command.YEAR           := 1970;
	        //Reset  Time to T#0s
	        #UserData.Time_Tag_in_Zone                    := T#0s;
	        #UserData.Time_Status_00                    := T#0s;
	        #UserData.Time_Status_05                    := T#0s;
	        (* Clear data structures; overwrite with 16#00 *)
	        FILL_BLK(IN := 16#0, COUNT := 31, OUT => #OutData[1]);                         (*internal OutData structure without Control Byte*)
	        FILL_BLK(IN := 16#0, COUNT := 192, OUT => #UserData.ReadData[0]);
	        FILL_BLK(IN := 16#0, COUNT := 22, OUT => #UserData.WriteData[0]);              (*WriteData structure with data which should write to the tag*)
	        FILL_BLK(IN := 16#0, COUNT := 30,  OUT => #UserData.SpecialCommand[0]);        (*Special command data field for tunneling function block*)
	        
	        #STATE_INIT                                 := #STATE_INIT + 1;                 (* Go to next state *)
	        
	        #Counter_FP := 0;
	        FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_1[0]);
	        FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_2[0]);
	        FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_3[0]);
	        FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_4[0]);
	        FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_5[0]);
	        FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_6[0]);
	        FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_7[0]);
	        FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_8[0]);
	        FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_9[0]);
	        FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_10[0]);
	
	        
	    2: (* ****************** Delete internal FIFO Memory / telegrams of IQT1-xx-IO-V1 *************** *)
	        
	        (* Set Deletebit *)
	        #OutData[0]                                 := ((#OutData[0] AND (NOT #MASK_DELETEBIT)) OR ((NOT #OutData[0]) AND #MASK_DELETEBIT));    (* Delete old telegrams in identsystem *)
	        
	        #STATE_INIT                                 := #STATE_INIT + 1;                 (* Go to next state *)
	        
	    3: (* ******************** Wait for delete bit in INPUTS equals OUTPUTS **************** *)
	        
	        IF ((#OutData[0] AND #MASK_DELETEBIT) = (( #InData[0] AND #MASK_DELETEBIT))) THEN       (*Check if the value of the Delete Bit is identically in input and output*)
	            #STATE_INIT                             := #STATE_INIT + 1;                 (* Go to next state *)
	        END_IF;
	        
	    4: (* ***************** Send Change Tag Command; stop command execution and configure Tag Type *************** *)
	        
	        (* Configure Change Tag command in OutData structure *)
	        #OutData[1]                                 := 16#07;           (*Frame length*)
	        #OutData[2]                                 := 16#00;           (*Fragmentation counter*)
	        #OutData[3]                                 := 16#00;           (*Telegram length High Byte*)
	        #OutData[4]                                 := 16#04;           (*Telegram length Low Byte*)
	        #OutData[5]                                 := 16#04;           (*Command Code Quit command*)
	        #OutData[6]                                 := #I_B_TagType;           (*ByteAddress High Byte*)
	        #OutData[7]                                 := 16#00;           (*ByteAddress Low Byte*)
	        #OutData[8]                                 := 16#00;           (*Byte Number High Byte*)
	        #OutData[9]                                 := 16#00;           (*Byte Number Low Byte*)
	        FILL_BLK(IN := 16#0, COUNT := 22,  OUT => #OutData[10]);
	        
	        #HEAD.Busy                                  := TRUE;
	        #O_b_Busy                                   := True;
	        #HEAD.Done                                  := FALSE;
	        #O_b_Done                                   := False;
	        #HEAD.TimeoutActive                         := TRUE;
	        #HEAD.SglCmdActive                          := TRUE;
	        #HEAD.EnhCmdActive                          := FALSE;
	        #HEAD.Execute                               := TRUE;
	        #HEAD.TransfToHead                          := TRUE;
	        
	        (* Handling of Handshake process for sending a new command *)
	        (* Check if IQT1-xx-IO-V1 is able to receive a new telegram; 
	        IQT1-xx-IO-V1 is able to receive new telegrams if the value of the UpdateBit_Master of the Input and Output is different *)
	        IF ((#OutData[0] AND #MASK_UPDATEBIT_MASTER) <> (#InData[0] AND #MASK_UPDATEBIT_MASTER)) THEN  (* Receiver (IQT1-xx-IO-V1) accepts a new Telegram *)
	                        (* Invert Updatebit master in order to signalize a new telegram is available *)
	            #OutData[0]                             := (#OutData[0] AND (NOT #MASK_UPDATEBIT_MASTER)) OR (#InData[0] AND #MASK_UPDATEBIT_MASTER);
	            #HEAD.SendOK                            := TRUE;
	        ELSE
	            #HEAD.SendOK                            := FALSE;  (* Receiver (IQT1-xx-IO-V1) doesnt't accept a new Telegram *)
	        END_IF;
	        
	        (* Send OutData field with Quit command to IQT1-xx-IO-V1 *)
	        IF #HEAD.SendOK THEN
	            
	            #HEAD.TransfToHead                      := FALSE;
	            #STATE_INIT                             := #STATE_INIT + 1; (* Go to next state *)
	        END_IF;
	        
	    5: (* ******************** Wait for Quit command response ************************ *)
	        IF #HEAD.ReceiveOK THEN (*If new telegram from IQT1-xx-IO-V1 is available*)
	            
	            #HEAD.NewData                           := TRUE;
	            #O_B_Status                             := #InData[6];          (*Copy received status value to Output variable Status*)
	            
	            IF #InData[6] = 16#0 THEN
	                #HEAD.ExistTC                       := TRUE;
	                #HEAD.NotExist                      := FALSE;
	            ELSE    (* Error *)
	                #HEAD.ExistTC                       := FALSE;
	                #HEAD.NotExist                      := TRUE;
	                #HEAD.Error                         := TRUE;
	                #O_b_Error                          := True;
	            END_IF;
	            
	            #HEAD.Busy                              := FALSE;
	            #O_b_Busy                               := False;
	            #HEAD.Done                              := TRUE;
	            #O_b_Done                               := True;
	            #O_b_Finish                             := TRUE;
	            #HEAD.SglCmdActive                      := FALSE;
	            #HEAD.TimeoutActive                     := FALSE;
	            #HEAD.Execute                           := FALSE;
	            #STATE_INIT                             := #STATE_INIT + 1; (* Go to next state *)
	        END_IF;
	        
	    6: (* Initialization finished  *)
	        IF #HEAD.ExistTC OR #HEAD.NotExist THEN
	            #IO_b_InitFinish                        := TRUE;
	            #IO_b_SetRestart                        := FALSE;
	            #STATE_INIT                             := 0; (* Go to idle state *)
	        END_IF;
	END_CASE;
	
	(*  ******************************************************************** Command Processing [Communication routine]   ****************************************************************************************************   *)
	IF #IO_b_InitFinish THEN
	    
	    (* ********** Commands ********** *)
	    IF NOT #HEAD.Execute THEN
	        
	        IF (*#RTRIG_Quit.Q OR*)#RTRIG_Read.Q OR #RTRIG_Write.Q OR #RTRIG_SpecialCommand.Q THEN
	            (* Discard previous #RECORD_DATA.INPUT content, except CONTROL Byte *)
	            #FragmentCounter_1                      := 16#00;
	            #FragmentCounter_2                      := 16#00;
	            #FragmentCounter_3                      := 16#00;
	            #FragmentCounter_4                      := 16#00;
	            #FragmentCounter_5                      := 16#00;
	            #FragmentCounter_6                      := 16#00;
	            #FragmentCounter_7                      := 16#00;
	            #FragmentCounter_8                      := 16#00;
	            #FragmentCounter_9                      := 16#00;
	            #FragmentCounter_10                     := 16#00;
	            FILL_BLK(IN := 16#0, COUNT := 192,  OUT => #UserData.ReadData[0]);
	            #SingleCommandFinished                  := False;
	            #O_b_NoDataCarrier                      := False;
	            //Reset Error output with trigger on new command
	            #HEAD.Error                             := FALSE;
	            #O_b_Error                              := False;
	            //Reset Read and Write counter with Trigger on new command
	            #O_w_AccessCounter                      := 0;
	            #AccessConter_Int                       := 0;
	            //Read out Local time with Trigger on new command (no Quit command, but Special command)
	            #Error_ScanTime                         := RD_LOC_T(#UserData.Date_Start_Command);
	            //Reset Read and Write time to T#0s
	            #UserData.Time_Tag_in_Zone                := T#0s;
	            #UserData.Time_Status_00                := T#0s;
	            #UserData.Time_Status_05                := T#0s;
	            
	            (*  (* ***** Quit ***** *)
	            IF #RTRIG_Quit.Q THEN
	                #OutData[1](*#Record_Data.OUTPUT.FrameLength*)          := 16#06;
	                #OutData[2](*#Record_Data.OUTPUT.FragmentationCounter*) := 16#00;
	                #OutData[3](*#Record_Data.OUTPUT.TelegramLengthHigh*)   := 16#00;
	                #OutData[4](*#Record_Data.OUTPUT.TelegramLengthLow*)    := 16#03;
	                #OutData[5](*#Record_Data.OUTPUT.Command*)              := 16#02; (* Command: QUIT *)
	                FILL_BLK(IN := 16#0,COUNT := 250,OUT => #OutData[6]);
	                
	                #HEAD.QuitCmdActive := True;
	                #HEAD.EnhCmdActive := FALSE;
	                #HEAD.TransfToHead := TRUE;
	                #STATE_CMD := 1;
	            END_IF;*)
	            
	              (* ***** Special Command ***** *)
	            IF #RTRIG_SpecialCommand.Q THEN
	                MOVE_BLK(IN := #UserData.SpecialCommand[0],  OUT => #OutData[1],  COUNT := 31);
	                #HEAD.SpecialCmdActive              := TRUE;
	                #HEAD.EnhCmdActive                  := FALSE;
	                #HEAD.WriteCmdActive                := False;
	                #HEAD.ReadCmdActive                 := False;
	                #HEAD.TransfToHead                  := TRUE;
	                #STATE_CMD                          := 1;
	            END_IF;
	            
	            (* ***** Single Read 4-Byte Block ***** *)
	            IF #RTRIG_Read.Q = True AND #I_b_UserMemory_UID = False (*AND #I_b_EPC = False*) AND #I_b_SingleEnhanced = FALSE THEN
	                #OutData[1]                         := 16#0A;                                                           (*Frame Length*)
	                #OutData[2]                         := 16#00;                                                           (*Fragmentation Counter*)
	                #OutData[3]                         := 16#00;                                                           (*Telegram Length High byte*)
	                #OutData[4]                         := 16#07;                                                           (*Telegram Length Low Byte*)
	                #OutData[5]                         := 16#10;                                                           (* Command: Single Read 4-Byte Block*)
	                #OutData[6]                         := WORD_TO_BYTE(SHR(IN := #I_w_ByteAddress AND 16#FF00, N := 8));   (*ByteAddress High Byte*)
	                #OutData[7]                         := WORD_TO_BYTE(#I_w_ByteAddress);                                  (*ByteAddress Low Byte*)
	                #OutData[8]                         := INT_TO_BYTE(SHR(IN := #I_i_ByteNumber AND 16#FF00, N := 8));     (*Byte Number High Byte*)
	                #OutData[9]                         := INT_TO_BYTE(#I_i_ByteNumber);                                    (*Byte Number Low Byte*)
	                FILL_BLK(IN := 16#0, COUNT := 22,  OUT => #OutData[10]);                                               (*Overwrite unused part of field with 16#00*)
	                #HEAD.SglCmdActive                  := TRUE;
	                #HEAD.EnhCmdActive                  := FALSE;
	                #HEAD.WriteCmdActive                := False;
	                #HEAD.ReadCmdActive                 := True;
	                #HEAD.TransfToHead                  := TRUE;
	                #STATE_CMD                          := 1;
	            END_IF;
	            
	            (* **** Enhanced Read 4-Byte Block ***** *)
	            IF #RTRIG_Read.Q = True AND #I_b_UserMemory_UID = False (*AND #I_b_EPC = False*) AND #I_b_SingleEnhanced = TRUE THEN
	                #OutData[1]                         := 16#0A;                                                           (*Frame Length*)
	                #OutData[2]                         := 16#00;                                                           (*Fragmentation Counter*)
	                #OutData[3]                         := 16#00;                                                           (*Telegram Length High Byte*)
	                #OutData[4]                         := 16#07;                                                           (*Telegram Length Low Byte*)
	                #OutData[5]                         := 16#19;                                                           (* Command: Enhanced Read 4-Byte Block*)
	                #OutData[6]                         := WORD_TO_BYTE(SHR(IN := #I_w_ByteAddress AND 16#FF00, N := 8));   (*ByteAddress High Byte*)
	                #OutData[7]                         := WORD_TO_BYTE(#I_w_ByteAddress);                                  (*ByteAddress Low Byte*)
	                #OutData[8]                         := INT_TO_BYTE(SHR(IN := #I_i_ByteNumber AND 16#FF00, N := 8));     (*Byte Number High Byte*)
	                #OutData[9]                         := INT_TO_BYTE(#I_i_ByteNumber);                                    (*Byte Number Low Byte*)
	                FILL_BLK(IN := 16#0, COUNT := 22, OUT => #OutData[10]);                                                (*Overwrite unused part of field with 16#00*)
	                #HEAD.SglCmdActive                  := FALSE;
	                #HEAD.EnhCmdActive                  := True;
	                #HEAD.WriteCmdActive                := False;
	                #HEAD.ReadCmdActive                 := True;
	                #HEAD.TransfToHead                  := TRUE;
	                #STATE_CMD                          := 1;
	            END_IF;
	            
	            (* ***** Single Read Fixcode (UID) ***** *)
	            IF #RTRIG_Read.Q = True AND #I_b_UserMemory_UID = TRUE (*AND #I_b_EPC = False*) AND #I_b_SingleEnhanced = FALSE THEN
	                #OutData[1]                         := 16#06;                                                           (*Frame Length*)
	                #OutData[2]                         := 16#00;                                                           (*Fragmentation Counter*)
	                #OutData[3]                         := 16#00;                                                           (*Telegram Length High Byte*)
	                #OutData[4]                         := 16#03;                                                           (*Telegram Length Low Byte*)
	                #OutData[5]                         := 16#01;                                                           (* Command: Single Read Fixcode*)
	                #OutData[6]                         := 16#00;                                                           (*ByteAddress High Byte*)
	                #OutData[7]                         := 16#00;                                                           (*ByteAddress Low Byte*)
	                #OutData[8]                         := 16#00;                                                           (*Byte Number High Byte*)
	                #OutData[9]                         := 16#00;                                                           (*Byte Number Low Byte*)
	                FILL_BLK(IN := 16#0, COUNT := 22, OUT => #OutData[10]);                                                (*Overwrite unused part of field with 16#00*)
	                #HEAD.SglCmdActive                  := TRUE;
	                #HEAD.EnhCmdActive                  := FALSE;
	                #HEAD.WriteCmdActive                := False;
	                #HEAD.ReadCmdActive                 := True;
	                #HEAD.TransfToHead                  := TRUE;
	                #STATE_CMD                          := 1;
	            END_IF;
	            
	            (* ***** Enhanced Read Fixcode (TID) ***** *)
	            IF #RTRIG_Read.Q = True AND #I_b_UserMemory_UID = TRUE (*AND #I_b_EPC = False*) AND #I_b_SingleEnhanced = TRUE THEN
	                #OutData[1]                         := 16#06;                                                           (*Frame Length*)
	                #OutData[2]                         := 16#00;                                                           (*Fragmentation Counter*)
	                #OutData[3]                         := 16#00;                                                           (*Telegram Length High Byte*)
	                #OutData[4]                         := 16#03;                                                           (*Telegram Length Low Byte*)
	                #OutData[5]                         := 16#1D;                                                           (* Command: Enhanced Read Fixcode*)
	                #OutData[6]                         := 16#00;                                                           (*ByteAddress High Byte*)
	                #OutData[7]                         := 16#00;                                                           (*ByteAddress Low Byte*)
	                #OutData[8]                         := 16#00;                                                           (*Byte Number High Byte*)
	                #OutData[9]                         := 16#00;                                                           (*Byte Number Low Byte*)
	                FILL_BLK(IN := 16#0, COUNT := 22, OUT => #OutData[10]);                                                (*Overwrite unused part of field with 16#00*)
	                #HEAD.SglCmdActive                  := FALSE;
	                #HEAD.EnhCmdActive                  := TRUE;
	                #HEAD.WriteCmdActive                := False;
	                #HEAD.ReadCmdActive                 := True;
	                #HEAD.TransfToHead                  := TRUE;
	                #STATE_CMD                          := 1;
	            END_IF;
	            
	            (*
	            (* **** Single Read UII (EPC/UII) ***** *)
	            IF #RTRIG_Read.Q = True AND #I_b_UserMemory_TID = FALSE AND #I_b_EPC = TRUE AND #I_b_SingleEnhanced = FALSE THEN
	                #OutData[1]                         := 16#06;                                                           (*Frame Length*)
	                #OutData[2]                         := 16#00;                                                           (*Fragmentation Counter*)
	                #OutData[3]                         := 16#00;                                                           (*Telegram Length High Byte*)
	                #OutData[4]                         := 16#03;                                                           (*Telegram Length Low Byte*)
	                #OutData[5]                         := 16#D2;                                                           (* Command: Single Read UII*)
	                #OutData[6]                         := 16#00;                                                           (*ByteAddress High Byte*)
	                #OutData[7]                         := 16#00;                                                           (*ByteAddress Low Byte*)
	                #OutData[8]                         := 16#00;                                                           (*Byte Number High Byte*)
	                #OutData[9]                         := 16#00;                                                           (*Byte Number Low Byte*)
	                FILL_BLK(IN := 16#0,COUNT := 22,OUT => #OutData[10]);                                                  (*Overwrite unused part of field with 16#00*)
	                #HEAD.SglCmdActive                  := TRUE;
	                #HEAD.EnhCmdActive                  := FALSE;
	                #HEAD.WriteCmdActive                := False;
	                #HEAD.ReadCmdActive                 := True;
	                #HEAD.TransfToHead                  := TRUE;
	                #STATE_CMD                          := 1;
	            END_IF;
	            
	            (* ***** Enhanced Read UII (EPC/UII) ***** *)
	            IF #RTRIG_Read.Q = True AND #I_b_UserMemory_TID = FALSE AND #I_b_EPC = TRUE AND #I_b_SingleEnhanced = TRUE THEN
	                #OutData[1]                         := 16#06;                                                           (*Frame Length*)
	                #OutData[2]                         := 16#00;                                                           (*Fragmentation Counter*)
	                #OutData[3]                         := 16#00;                                                           (*Telegram Length High Byte*)
	                #OutData[4]                         := 16#03;                                                           (*Telegram Length Low Byte*)
	                #OutData[5]                         := 16#D3;                                                           (* Command: Enhanced Read UII*)
	                #OutData[6]                         := 16#00;                                                           (*ByteAddress High Byte*)
	                #OutData[7]                         := 16#00;                                                           (*ByteAddress Low Byte*)
	                #OutData[8]                         := 16#00;                                                           (*Byte Number High Byte*)
	                #OutData[9]                         := 16#00;                                                           (*Byte Number Low Byte*)
	                FILL_BLK(IN := 16#0, COUNT := 22,OUT => #OutData[10]);                                                 (*Overwrite unused part of field with 16#00*)
	                #HEAD.SglCmdActive                  := FALSE;
	                #HEAD.EnhCmdActive                  := TRUE;
	                #HEAD.WriteCmdActive                := False;
	                #HEAD.ReadCmdActive                 := True;
	                #HEAD.TransfToHead                  := TRUE;
	                #STATE_CMD                          := 1;
	            END_IF;
	            *)
	            
	            (* ***** Single Write 4-Byte Block ***** *)
	            IF #RTRIG_Write.Q = True AND #I_b_UserMemory_UID = False (*AND #I_b_EPC = False*) AND #I_b_SingleEnhanced = FALSE THEN
	                #OutData[1]                         := INT_TO_BYTE(#I_i_ByteNumber) + 16#0A;                             (*Frame Length*)
	                #OutData[2]                         := 16#00;                                                           (*Fragmentation Counter*)
	                #OutData[3]                         := 16#00;                                                           (*Telegram Length High byte*)
	                #OutData[4]                         := INT_TO_BYTE(#I_i_ByteNumber) + 16#07;                             (*Telegram Length Low Byte*)
	                #OutData[5]                         := 16#40;                                                           (* Command: Single Write 4-Byte Block*)
	                #OutData[6]                         := WORD_TO_BYTE(SHR(IN := #I_w_ByteAddress AND 16#FF00, N := 8));   (*ByteAddress High Byte*)
	                #OutData[7]                         := WORD_TO_BYTE(#I_w_ByteAddress);                                  (*ByteAddress Low Byte*)
	                #OutData[8]                         := INT_TO_BYTE(SHR(IN := #I_i_ByteNumber AND 16#FF00, N := 8));     (*Byte Number High Byte*)
	                #OutData[9]                         := INT_TO_BYTE(#I_i_ByteNumber);                                    (*Byte Number Low Byte*)
	                MOVE_BLK(IN := #UserData.WriteData[0],OUT => #OutData[10], COUNT := 22);                                (*Copy WriteData field to output field*)
	                #HEAD.SglCmdActive                  := TRUE;
	                #HEAD.WriteCmdActive                := True;
	                #HEAD.ReadCmdActive                 := FALSE;
	                #HEAD.EnhCmdActive                  := FALSE;
	                #HEAD.TransfToHead                  := TRUE;
	                #STATE_CMD                          := 1;
	            END_IF;
	            
	            (* ***** Enhanced Write 4-Byte Block ***** *)
	            IF #RTRIG_Write.Q = True AND #I_b_UserMemory_UID = False (*AND #I_b_EPC = False*) AND #I_b_SingleEnhanced = TRUE THEN
	                #OutData[1]                         := INT_TO_BYTE(#I_i_ByteNumber) + 16#0A;                             (*Frame Length*)
	                #OutData[2]                         := 16#00;                                                           (*Fragmentation Counter*)
	                #OutData[3]                         := 16#00;                                                           (*Telegram Length High byte*)
	                #OutData[4]                         := INT_TO_BYTE(#I_i_ByteNumber) + 16#07;                             (*Telegram Length Low Byte*)
	                #OutData[5]                         := 16#1A;                                                           (* Command: Enhanced Write 4-Byte Block*)
	                #OutData[6]                         := WORD_TO_BYTE(SHR(IN := #I_w_ByteAddress AND 16#FF00, N := 8));   (*ByteAddress High Byte*)
	                #OutData[7]                         := WORD_TO_BYTE(#I_w_ByteAddress);                                  (*ByteAddress Low Byte*)
	                #OutData[8]                         := INT_TO_BYTE(SHR(IN := #I_i_ByteNumber AND 16#FF00, N := 8));     (*Byte Number High Byte*)
	                #OutData[9]                         := INT_TO_BYTE(#I_i_ByteNumber);                                    (*Byte Number Low Byte*)
	                MOVE_BLK(IN := #UserData.WriteData[0],OUT => #OutData[10],  COUNT := 22);                              (*Copy WriteData field to output field*)
	                #HEAD.SglCmdActive                  := FALSE;
	                #HEAD.WriteCmdActive                := True;
	                #HEAD.ReadCmdActive                 := FALSE;
	                #HEAD.EnhCmdActive                  := TRUE;
	                #HEAD.TransfToHead                  := TRUE;
	                #STATE_CMD                          := 1;
	            END_IF;
	            
	            (*
	            (* **** Single Write EPC/UII ***** *)
	            IF #RTRIG_Write.Q = True AND #I_b_UserMemory_TID = False AND #I_b_EPC = True AND #I_b_SingleEnhanced = FALSE THEN
	                #OutData[1]                         := INT_TO_BYTE(#I_i_ByteNumber) + 16#07;                            (*Frame Length*)
	                #OutData[2]                         := 16#00;                                                           (*Fragmentation Counter*)
	                #OutData[3]                         := 16#00;                                                           (*Telegram Length High byte*)
	                #OutData[4]                         := INT_TO_BYTE(#I_i_ByteNumber) + 16#04;                            (*Telegram Length Low Byte*)
	                #OutData[5]                         := 16#CE;                                                           (* Command: Single Write EPC/UII*)
	                #OutData[6]                         := INT_TO_BYTE(#I_i_ByteNumber);                                    (*Length of EPC Information; 2 Byte PC Word + EPC/UII*)
	                MOVE_BLK(IN := #UserData.WriteData[0], OUT => #OutData[7],  COUNT := 22);                              (*Copy WriteData field to output field*)
	                #HEAD.SglCmdActive                  := TRUE;
	                #HEAD.WriteCmdActive                := True;
	                #HEAD.ReadCmdActive                 := FALSE;
	                #HEAD.EnhCmdActive                  := FALSE;
	                #HEAD.TransfToHead                  := TRUE;
	                #STATE_CMD                          := 1;
	            END_IF;
	            *)
	            
	        END_IF;
	        
	        IF #RTRIG_Quit.Q THEN
	            //Reset Error if Quit command triggered
	            #HEAD.Error                             := FALSE;
	            #O_b_Error                              := False;
	            
	              (* ***** Quit ***** *)
	            #OutData[1]                             := 16#06;                                                           (*Frame Length*)
	            #OutData[2]                             := 16#00;                                                           (*Fragmentation Counter*)
	            #OutData[3]                             := 16#00;                                                           (*Telegram Length High byte*)
	            #OutData[4]                             := 16#03;                                                           (*Telegram Length Low Byte*)
	            #OutData[5]                             := 16#02;                                                           (* Command: QUIT *)
	            FILL_BLK(IN := 16#0, COUNT := 28,  OUT => #OutData[6]);
	            #HEAD.QuitCmdActive                     := True;
	            #HEAD.SpecialCmdActive                  := FALSE;
	            #HEAD.EnhCmdActive                      := FALSE;
	            #HEAD.TransfToHead                      := TRUE;
	            #HEAD.WriteCmdActive                    := FALSE;
	            #HEAD.ReadCmdActive                     := FALSE;
	            #STATE_CMD                              := 1;
	        END_IF;
	    END_IF;
	    
	            (* ***** Handle communication and analysis ***** *)
	            CASE #STATE_CMD OF
	                    
	                0: (* ***** Idle state ***** *)
	                    ;
	                1:(* ***** Execution ***** *)
	                    IF #HEAD.TransfToHead THEN
	                        #HEAD.Busy                  := TRUE;
	                        #O_b_Busy                   := True;
	                        #HEAD.Done                  := FALSE;
	                        #O_b_Done                   := False;
	                        #O_b_Finish                 := False;
	                        #HEAD.SendOK                := FALSE;
	                        #HEAD.ReceiveOK             := FALSE;
	                        #HEAD.NewData               := FALSE;
	                        #HEAD.TimeoutActive         := TRUE;
	                        #HEAD.TimeoutOccurred       := FALSE;
	                        #HEAD.Execute               := TRUE;
	                        #O_b_NoDataCarrier          := False;
	                        #O_b_Finish                 := False;
	                        
	                        (* ***** Handshake-WRITE ***** *)
	                        (* Check if IQT1-xx-IO-V1 is able to receive a new telegram *)
	                        IF ((#OutData[0] AND #MASK_UPDATEBIT_MASTER) <> (#InData[0] AND #MASK_UPDATEBIT_MASTER)) THEN
	                            (* Receiver (IQT1-xx-IO-V1) accepts a new Telegram *)
	                            
	                            (* Invert Updatebit master in order to signalize a new telegram is available *)
	                            #OutData[0]             := (#OutData[0] AND (NOT #MASK_UPDATEBIT_MASTER)) OR (#InData[0] AND #MASK_UPDATEBIT_MASTER);
	                            #HEAD.SendOK            := TRUE;
	                            
	                            //Test KReinhardt 2023-06-28
	                            #Counter_FP             := 0;
	                            FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_1[0]);
	                            FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_2[0]);
	                            FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_3[0]);
	                            FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_4[0]);
	                            FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_5[0]);
	                            FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_6[0]);
	                            FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_7[0]);
	                            FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_8[0]);
	                            FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_9[0]);
	                            FILL_BLK(IN := 16#0, COUNT := 32, OUT => #Resp_Telegram_10[0]);
	                           
	                        ELSE
	                            (* Receiver (IQT1-xx-IO-V1) doesnt't accept a new Telegram *)
	                            #HEAD.SendOK            := FALSE;
	                        END_IF;
	                        
	                            (* Send CMD to identsystem *)
	                        IF #HEAD.SendOK THEN
	
	                            #HEAD.TransfToHead      := FALSE;
	                            #STATE_CMD              := #STATE_CMD + 1; (* Go to next state *)
	                        END_IF;
	                    END_IF;
	                    
	                    
	                2:(* ***** Analyze InData ***** *)
	                    (* Receive Telegram *)
	                    IF #HEAD.ReceiveOK THEN //(ReceiveTelegram(ChannelLocal := nChannel) = TRUE ) THEN
	                        #HEAD.NewData               := TRUE;
	                        
	                        (* Data carrier detected *)
	                        IF #InData[6] = 16#0  OR #InData[6] = 16#B THEN
	                            #HEAD.Done              := TRUE;
	                        (* No data carrier detected *)
	                       // ELSIF #InData[6] = 16#5 THEN
	                       //     #O_b_NoDataCarrier      := TRUE;
	                       //     #HEAD.Done              := False;
	                        END_IF;
	                        
	                        //Status 16#00 response during Quit command or Special command -> command successfully finished
	                        IF #InData[6] = 16#0 AND #HEAD.QuitCmdActive = True THEN
	                            #HEAD.Done              := TRUE;
	                            #O_b_Done               := True;
	                            #O_b_Finish             := True;
	                            #HEAD.Busy              := False;
	                            #O_b_Busy               := False;
	                            #HEAD.NewData           := False;
	                            #HEAD.QuitCmdActive     := False;
	                            #HEAD.Execute           := FALSE;
	                            #HEAD.TimeoutActive     := FALSE;
	                            #STATE_CMD              := 0; (* Go to idle state *)
	                            #O_b_NoDataCarrier      := False;
	                            #O_b_Finish             := True;
	                        END_IF;
	                        
	                        //Status 16#00 response during  Special command -> command successfully finished
	                        IF #InData[6] = 16#0 AND #HEAD.SpecialCmdActive = True THEN
	                            #HEAD.Done              := TRUE;
	                            #O_b_Done               := True;
	                            #HEAD.Busy              := False;
	                            #O_b_Busy               := False;
	                            #HEAD.NewData           := False;
	                            #HEAD.SpecialCmdActive  := False;
	                            #HEAD.Execute           := FALSE;
	                            #HEAD.TimeoutActive     := FALSE;
	                            #STATE_CMD              := 0; (* Go to idle state *)
	                            #O_b_NoDataCarrier      := False;
	                            #O_b_Finish             := True;
	                        END_IF;
	                        
	                        IF #InData[6] = 16#5 AND #HEAD.SpecialCmdActive = True THEN
	                            #HEAD.Done := TRUE;
	                            #O_b_Done := True;
	                            #HEAD.Busy := False;
	                            #O_b_Busy := False;
	                            #HEAD.NewData := False;
	                            #HEAD.SpecialCmdActive := False;
	                            #HEAD.Execute := FALSE;
	                            #HEAD.TimeoutActive := FALSE;
	                            #STATE_CMD := 0; (* Go to idle state *)
	                            #O_b_NoDataCarrier := TRUE;
	                            #O_b_Finish := True;
	                        END_IF;
	                        
	                        //Status 16#04 response during Quit command or Special command -> Error
	                        IF #InData[6] = 16#4 AND #HEAD.QuitCmdActive = True OR #HEAD.SpecialCmdActive = TRUE THEN
	                            #HEAD.Done              := TRUE;
	                            #O_b_Done               := True;
	                            #HEAD.Busy              := False;
	                            #O_b_Busy               := False;
	                            #HEAD.NewData           := False;
	                            #HEAD.QuitCmdActive     := False;
	                            #HEAD.Execute           := FALSE;
	                            #HEAD.TimeoutActive     := FALSE;
	                            #STATE_CMD              := 0; (* Go to idle state *)
	                            #O_b_NoDataCarrier      := False;
	                            #O_b_Finish             := True;
	                        END_IF;
	                        
	  
	                        //Status 16#00 response during write command -> contains EPC information of written tag
	                        IF #InData[6] = 16#0 AND #HEAD.WriteCmdActive = True THEN
	                            #STATE_CMD              := 2; (* Go to idle state *)
	                         //   MOVE_BLK(IN := #InData[7], OUT => #UserData.UID_WrittenTag[0], COUNT := 25);
	                        END_IF;
	                    END_IF;
	            END_CASE;
	        END_IF;
	        
	(* ***** Timeout Control **** *)
	        #WATCHDOG(IN:=#HEAD.TimeoutActive, PT:= #I_T_Timeout);
	        
	        IF #WATCHDOG.Q THEN
	            #HEAD.TimeoutActive                     := FALSE;
	            #HEAD.TimeoutOccurred                   := TRUE;
	            #HEAD.SendOK                            := FALSE;
	            #HEAD.ReceiveOK                         := FALSE;
	            #HEAD.SglCmdActive                      := FALSE;
	            #HEAD.EnhCmdActive                      := FALSE;
	            #HEAD.Execute                           := FALSE;
	            #HEAD.TransfToHead                      := FALSE;
	            #HEAD.Error                             := TRUE;
	            #O_b_Error                              := True;
	            #HEAD.Busy                              := FALSE;
	            #O_b_Busy                               := false;
	            #HEAD.Done                              := TRUE;
	            #O_b_Done                               := True;
	        END_IF;
	        
	        #RETVAL_SFC15                               := DPWR_DAT(LADDR := #I_HWIO_Hardware_ID, RECORD := #OutData(*#Record_Data.OUTPUT*));
	
	
END_FUNCTION_BLOCK

